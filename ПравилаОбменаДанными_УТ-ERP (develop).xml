Выполнить(Алгоритмы.СцепкаДляПоискаРодителя); </ПередВыгрузкой>
				<ПослеЗагрузки>Если Не Объект.ЭтоГруппа И ПараметрыОбъекта &lt;&gt; Неопределено Тогда 
	
	Если Объект.ЭтоНовый() Тогда
		СсылкаНаОбъект = Объект.ПолучитьСсылкуНового();
		Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
			СсылкаНаОбъект = Справочники.Контрагенты.ПолучитьСсылку();
			Объект.УстановитьСсылкуНового(СсылкаНаОбъект);
		КонецЕсли;
	Иначе
		СсылкаНаОбъект = Объект.Ссылка;
	КонецЕсли;
	
	// Заполнение реквизита Родитель
	Сцепка = ПараметрыОбъекта.Получить("СцепкаПараметр");
	Если ЗначениеЗаполнено(Сцепка) И Не ЗначениеЗаполнено(Объект.Родитель) Тогда
		
		ДопОбработка = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию("Макеты");
		ВнешняяОбработкаОбъект = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(ДопОбработка);		
		Объект.Родитель = ВнешняяОбработкаОбъект.РодительПоСцепке("УТ", Сцепка);
		
	КонецЕсли;
		
	// Заполнение реквизита ВидНоменклатуры 
	Технический = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Технический");
	
	Если Не ЗначениеЗаполнено(Объект.ВидНоменклатуры) Тогда 
		
		ИспользованиеХарактеристик = ПараметрыОбъекта.Получить("ИспользованиеХарактеристик");
		НаименованиеВидаНоменклатуры = ПараметрыОбъекта.Получить("НаименованиеВидаНоменклатуры");
		НаименованиеВидаНоменклатурыПриёмник = Параметры.СоответствиеВидовНоменклатуры.Получить(НаименованиеВидаНоменклатуры);
		Если ЗначениеЗаполнено(НаименованиеВидаНоменклатурыПриёмник) Тогда 
			Если НаименованиеВидаНоменклатурыПриёмник = "Полуфабрикаты" И ИспользованиеХарактеристик Тогда
				НаименованиеВидаНоменклатурыПриёмник = "Полуфабрикаты собственные";
			КонецЕсли;
			Объект.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию(НаименованиеВидаНоменклатурыПриёмник);	
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.ВидНоменклатуры) Тогда
			Объект.ВидНоменклатуры = Технический;	
		КонецЕсли;
		
		ЕдИзмСрокаГодности = Объект.ЕдиницаИзмеренияСрокаГодности;
		ВесИспользовать = Объект.ВесИспользовать;
		ВесМожноУказыватьВДокументах = Объект.ВесМожноУказыватьВДокументах;
		
		Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(Объект, Ложь, Ложь, Объект.ВидНоменклатуры, Ложь); 
		
		Объект.ЕдиницаИзмеренияСрокаГодности = ЕдИзмСрокаГодности;
		Объект.ВесИспользовать = ВесИспользовать;
		Объект.ВесМожноУказыватьВДокументах = ВесМожноУказыватьВДокументах;
		
	КонецЕсли;
	
	// Заполнение реквизита ОбъемЕдиницаИзмерения
	Если ЗначениеЗаполнено(Объект.ОбъемИспользовать) Тогда
		Объект.ОбъемЕдиницаИзмерения = НоменклатураСервер.ЕдиницаИзмеренияПоУмолчанию("Объем");
	КонецЕсли;
	
	Объект.ОбъемМожноУказыватьВДокументах = Ложь;
	
	// Заполнение реквизита ВесИспользовать
	Если Объект.ВесЧислитель &gt; 0 Тогда
		Объект.ВесИспользовать = Истина;
		Объект.ВесЕдиницаИзмерения = НоменклатураСервер.ЕдиницаИзмеренияПоУмолчанию("Вес");
		Объект.ВесМожноУказыватьВДокументах = Истина;
	КонецЕсли;
	
	// Заполнение Ед. изм ТНВЭД
	Если ЗначениеЗаполнено(Объект.КодТНВЭД) Тогда
		Объект.ЕдиницаИзмеренияТНВЭД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КодТНВЭД, "ЕдиницаИзмерения");	
	КонецЕсли;
	
КонецЕсли;

Если ОбъектНайден Тогда
	
	// Восстанавливаем реквизиты из ссылки, т.к. их нельзя перезаполнять
	Ссылка = Объект.Ссылка;
	
	ДанныеСсылки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "СтавкаНДС");
	
	Для каждого Элемент Из ДанныеСсылки Цикл
		
