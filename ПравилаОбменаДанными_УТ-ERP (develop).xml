		</Группа>
	</ПравилаВыгрузкиДанных>
	<ПравилаОчисткиДанных/>
	<Алгоритмы>
		<Алгоритм Имя="ВыгрузкаДопРеквизитовИСведений" ИспользуетсяПриЗагрузке="false">
			<Текст>Если Не Источник.ЭтоГруппа Тогда
	
	НеВыгружатьПовторно = Ложь;
	Если ВходящиеДанные &lt;&gt; Неопределено Тогда
		ВходящиеДанные.Свойство("НеВыгружатьПовторно", НеВыгружатьПовторно);
	КонецЕсли; 
	Если НеВыгружатьПовторно = Неопределено Тогда
		НеВыгружатьПовторно = Ложь;
	КонецЕсли;
	
	СписокДопСведенийИРеквизитовКВыгрузке = Параметры.СписокДопСведенийИРеквизитовКВыгрузке;
	ДопСвойства = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НоменклатураДополнительныеРеквизиты.Свойство КАК Свойство,
	|	НоменклатураДополнительныеРеквизиты.Значение КАК Значение
	|ИЗ
	|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	|ГДЕ
	|	НоменклатураДополнительныеРеквизиты.Ссылка = &amp;Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Источник);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(Выборка.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		ДопСвойства.Вставить(Выборка.Свойство, Выборка.Значение);
		
		Если СписокДопСведенийИРеквизитовКВыгрузке.Найти(Выборка.Свойство) &lt;&gt; Неопределено И НЕ НеВыгружатьПовторно Тогда 
			
			ВходящиеДанныеПравилу = Новый Структура;
			
			Если Выборка.Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Заголовок", "Категория") Тогда
				ВходящиеДанныеПравилу.Вставить("ЭтоДополнительноеСведение", Истина);
			КонецЕсли;
			
			СтруктураИсточника = Новый Структура;
			СтруктураИсточника.Вставить("Объект", Источник);
			СтруктураИсточника.Вставить("Свойство", Выборка.Свойство);
			СтруктураИсточника.Вставить("Значение", Выборка.Значение); 
			ВыгрузитьПоПравилу(СтруктураИсточника, , ВходящиеДанныеПравилу, , "ДополнительныеСведения");
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВходящиеДанные = Неопределено Тогда
		ВходящиеДанные = Новый Структура;
	КонецЕсли;
	
	ВходящиеДанные.Вставить("ДопСвойства", ДопСвойства);
	
КонецЕсли;</Текст>
			<Параметры>Источник, ВходящиеДанные</Параметры>
		</Алгоритм>
		<Алгоритм Имя="НаименованиеСтавкиНДС" ИспользуетсяПриЗагрузке="false">
			<Текст>Если ЗначениеСтавки = Перечисления.СтавкиНДС.НДС20 Тогда
	НаименованиеСтавки = "20%";
ИначеЕсли ЗначениеСтавки = Перечисления.СтавкиНДС.НДС20_120 Тогда
	НаименованиеСтавки = "20/120";
ИначеЕсли ЗначениеСтавки = Перечисления.СтавкиНДС.НДС10 Тогда
	НаименованиеСтавки = "10%";
ИначеЕсли ЗначениеСтавки = Перечисления.СтавкиНДС.НДС10_110 Тогда
	НаименованиеСтавки = "10/110";
ИначеЕсли ЗначениеСтавки = Перечисления.СтавкиНДС.НДС0 Тогда
	НаименованиеСтавки = "0%";
ИначеЕсли ЗначениеСтавки = Перечисления.СтавкиНДС.БезНДС Тогда
	НаименованиеСтавки = "Без НДС";
ИначеЕсли ЗначениеСтавки = Перечисления.СтавкиНДС.НДС18 Тогда
	НаименованиеСтавки = "18%";
ИначеЕсли ЗначениеСтавки = Перечисления.СтавкиНДС.НДС18_118 Тогда
	НаименованиеСтавки = "18/118";
ИначеЕсли ЗначениеСтавки = Перечисления.СтавкиНДС.НДС5 Тогда
	НаименованиеСтавки = "5%";
ИначеЕсли ЗначениеСтавки = Перечисления.СтавкиНДС.НДС5_105 Тогда
	НаименованиеСтавки = "5/105";
ИначеЕсли ЗначениеСтавки = Перечисления.СтавкиНДС.НДС7 Тогда
	НаименованиеСтавки = "7%";
ИначеЕсли ЗначениеСтавки = Перечисления.СтавкиНДС.НДС7_107 Тогда
	НаименованиеСтавки = "=7/107";
ИначеЕсли ЗначениеСтавки = Перечисления.СтавкиНДС.НДС22 Тогда
	НаименованиеСтавки = "22%";
ИначеЕсли ЗначениеСтавки = Перечисления.СтавкиНДС.НДС22_122 Тогда
	НаименованиеСтавки = "22/122";
КонецЕсли;</Текст>
			<Параметры>НаименованиеСтавки, ЗначениеСтавки</Параметры>
		</Алгоритм>
		<Алгоритм Имя="СцепкаДляПоискаРодителя" ИспользуетсяПриЗагрузке="false">
			<Текст>Если Не Источник.ЭтоГруппа Тогда
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Родитель.Наименование КАК Группа5,
	|	Номенклатура.Родитель.Родитель.Наименование КАК Группа4,
	|	Номенклатура.Родитель.Родитель.Родитель.Наименование КАК Группа3,
	|	Номенклатура.Родитель.Родитель.Родитель.Родитель.Наименование КАК Группа2,
	|	Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Наименование КАК Группа1
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &amp;Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Источник);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если ВходящиеДанные = Неопределено Тогда
		ВходящиеДанные = Новый Структура;
	КонецЕсли;
	
	Если Выборка.Следующий() Тогда
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить(СокрЛП(Выборка.Группа1)); 
		МассивСтрок.Добавить(СокрЛП(Выборка.Группа2));
		МассивСтрок.Добавить(СокрЛП(Выборка.Группа3));
		МассивСтрок.Добавить(СокрЛП(Выборка.Группа4));
		МассивСтрок.Добавить(СокрЛП(Выборка.Группа5));
		
		Сцепка = СтрСоединить(МассивСтрок);
		
		ВходящиеДанные.Вставить("Сцепка", Сцепка); 
	КонецЕсли;
	
КонецЕсли;</Текст>
			<Параметры>Источник, ВходящиеДанные</Параметры>
		</Алгоритм>
	</Алгоритмы>
